# Flume — copy to .env.local (never commit real secrets)
# Supabase project: rinybhztdjmqbzfzsiog
# Dashboard → Project Settings → API
# Auth → URL Configuration:
#   Site URL: https://flume-ten.vercel.app
#   Redirect URLs: https://flume-ten.vercel.app/auth/callback , http://localhost:3000/auth/callback

NEXT_PUBLIC_SUPABASE_URL=https://rinybhztdjmqbzfzsiog.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional override (demo seed tenant only — live sessions use the signed-in user tenant)
# FLUME_DEMO_TENANT_ID=11111111-1111-1111-1111-111111111111

APP_URL=https://flume-ten.vercel.app

# Paystack billing (NGN) — use sk_test_ / pk_test_ in sandbox
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional: dedicated webhook secret; otherwise HMAC uses PAYSTACK_SECRET_KEY
PAYSTACK_WEBHOOK_SECRET=
# Plan codes from Paystack dashboard (PLN_…) — may be TBD until plans are created
PAYSTACK_PLAN_PRO_MONTH=
PAYSTACK_PLAN_PRO_YEAR=
# PAYSTACK_API_BASE=https://api.paystack.co

# Meta / WhatsApp
META_APP_SECRET=
META_VERIFY_TOKEN=flume-verify
WHATSAPP_VERIFY_TOKEN=flume-wa-verify

# TikTok Marketing API — Instant Form lead ingest (MVP single-tenant)
# App credentials: TikTok for Business Developer Portal → My Apps
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Long-lived advertiser access token (OAuth / Ads Manager). Multi-tenant OAuth later:
# Integrations "Connect TikTok" can PATCH /api/connections + store token on connections.tokens_enc.
TIKTOK_ACCESS_TOKEN=
# Optional default advertiser; webhook payload advertiser_id wins when present
TIKTOK_ADVERTISER_ID=
# Optional tenant for webhook ingest (defaults to FLUME_DEMO_TENANT_ID / demo seed)
# TIKTOK_TENANT_ID=
# Webhook URL (register in Subscription / Lead CRM callback):
#   https://flume-ten.vercel.app/api/webhooks/tiktok
# Signature: TikTok-Signature HMAC (t=<ts>,s=<hex>) with CLIENT_SECRET, or header
#   X-Flume-TikTok-Secret / X-TikTok-Webhook-Secret matching CLIENT_SECRET.
# Local/dev only — never enable in production:
# TIKTOK_WEBHOOK_ALLOW_UNSIGNED=1
